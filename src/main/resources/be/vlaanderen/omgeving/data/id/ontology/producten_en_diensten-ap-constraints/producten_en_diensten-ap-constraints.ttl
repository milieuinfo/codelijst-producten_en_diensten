@prefix owl:           <http://www.w3.org/2002/07/owl#> .
@prefix xhv:           <http://www.w3.org/1999/xhtml/vocab#> .
@prefix xsd:           <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:          <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs:          <http://www.w3.org/2000/01/rdf-schema#> .
@prefix omg_dataset:   <https://data.omgeving.vlaanderen.be/id/dataset/> .
@prefix dct:           <http://purl.org/dc/terms/> .
@prefix sh:            <http://www.w3.org/ns/shacl#> .
@prefix omg_ont:       <https://data.omgeving.vlaanderen.be/id/ontology/> .
@prefix omg_voc:       <https://data.omgeving.vlaanderen.be/ns/> .
@prefix vl_org:        <http://data.vlaanderen.be/id/organisatie/> .
@prefix xkos:          <http://rdf-vocabulary.ddialliance.org/xkos#> .
@prefix omg_ps:        <https://data.omgeving.vlaanderen.be/id/propertyshape/> .
@prefix rdf:           <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix ons:           <https://data.omgeving.vlaanderen.be/id/nodeshape/> .
@prefix conceptscheme: <https://data.omgeving.vlaanderen.be/id/conceptscheme/> .

omg_ont:producten_en_diensten-ap-constraints
    a               owl:Ontology ;
    rdfs:label      "Producten en diensten AP Constraints"@nl ;
    rdfs:comment    "Specificeert hoe de codelijst van de producten en diensten van het Departement Omgeving in RDF geëncodeerd wordt (RDF-termen, kardinaliteiten, ...)."@nl ;
    dct:title       "Producten en diensten AP Constraints"@nl ;
    dct:alternative "Producten en diensten AP Shapes"@nl ;
    dct:abstract    "Het applicatieprofiel van de producten- en dienstencatalogus (PDC) van het Departement Omgeving specificeert de RDF-termen en bijhorende constraints voor het beschrijven van de producten en diensten. De catalogus is een SKOS-conceptschema met drie niveaus (dienst 1, dienst 2, dienst 3), waarbij de diensten van niveau 3 gegroepeerd worden in SKOS-collecties volgens type dienst, fase in de beleidscyclus, betrokken afdeling, intern of extern gericht en interne of externe trigger. Er worden enkel bestaande termen uit SKOS hergebruikt."@nl ;
    dct:description "Dit is de SHACL-encodering van het applicatieprofiel van de codelijst producten en diensten."@nl ;
    dct:creator     vl_org:OVO003749 ;
    dct:issued      "2022-10-03"^^xsd:date ;
    dct:modified    "2026-11-03"^^xsd:date ;
    xkos:belongsTo  omg_dataset:codelijst-producten_en_diensten ;
    xhv:last        omg_voc:producten_en_diensten-ap-constraints ;
    owl:sameAs      omg_voc:producten_en_diensten-ap-constraints ;
    owl:versionInfo "Versie 2.0.0 november 2026"@nl .

omg_voc:producten_en_diensten-ap-constraints
    a          owl:Ontology ;
    rdfs:label "Producten en diensten AP Constraints"@nl ;
    owl:sameAs omg_ont:producten_en_diensten-ap-constraints .

# ---------------------------------------------------------------------------
# Node Shapes
# ---------------------------------------------------------------------------

ons:producten_en_diensten
    a                sh:NodeShape ;
    rdfs:label       "product of dienst"@nl ;
    sh:name          "product of dienst"@nl ;
    sh:description   "Een dienst uit de producten- en dienstencatalogus van het Departement Omgeving, op niveau 1, 2 of 3. Een dienst van niveau 1 is een topconcept zonder breder concept; diensten van niveau 2 en 3 hebben precies één breder concept. Geldt voor elke resource met een skos:notation, zodat concepten uit andere conceptschema's (bv. in de CPSV-AP-data) niet aan deze regels moeten voldoen; ons:concept_in_producten_en_diensten zorgt dat elk concept van dit schema een notatie heeft."@nl ;
    rdfs:isDefinedBy omg_ont:producten_en_diensten-ap-constraints, omg_voc:producten_en_diensten-ap-constraints ;
    sh:targetSubjectsOf skos:notation ;
    sh:class         skos:Concept ;
    sh:property      omg_ps:rdf_type, omg_ps:prefLabel, omg_ps:altLabel, omg_ps:notation,
                     omg_ps:inScheme, omg_ps:inScheme_producten_en_diensten, omg_ps:topConceptOf, omg_ps:broader,
                     omg_ps:definition, omg_ps:note ;
    sh:xone          ( ons:producten_en_diensten_niveau_1 ons:producten_en_diensten_niveau_2_3 ) .

ons:concept_in_producten_en_diensten
    a                sh:NodeShape ;
    rdfs:label       "concept in de producten- en dienstencatalogus"@nl ;
    sh:name          "concept in de producten- en dienstencatalogus"@nl ;
    sh:description   "Een concept dat tot het conceptschema producten en diensten behoort, heeft een notatie, en valt daardoor onder ons:producten_en_diensten."@nl ;
    rdfs:isDefinedBy omg_ont:producten_en_diensten-ap-constraints, omg_voc:producten_en_diensten-ap-constraints ;
    sh:targetClass   skos:Concept ;
    sh:not           [ sh:and ( [ sh:property [ sh:path skos:inScheme ; sh:hasValue conceptscheme:producten_en_diensten ] ]
                                [ sh:property [ sh:path skos:notation ; sh:maxCount 0 ] ] ) ] ;
    sh:message       "Een concept in conceptscheme:producten_en_diensten moet een skos:notation hebben."@nl .

ons:producten_en_diensten_niveau_1
    a                sh:NodeShape ;
    rdfs:label       "dienst niveau 1"@nl ;
    sh:description   "Een dienst van niveau 1: topconcept van het schema, zonder breder concept, met notatie D1-nnnn."@nl ;
    rdfs:isDefinedBy omg_ont:producten_en_diensten-ap-constraints, omg_voc:producten_en_diensten-ap-constraints ;
    sh:property      [ sh:path skos:topConceptOf ; sh:minCount 1 ] ,
                     [ sh:path skos:broader ; sh:maxCount 0 ] ,
                     [ sh:path skos:notation ; sh:pattern "^D1-[0-9]{4}$" ] .

ons:producten_en_diensten_niveau_2_3
    a                sh:NodeShape ;
    rdfs:label       "dienst niveau 2 of 3"@nl ;
    sh:description   "Een dienst van niveau 2 of 3: geen topconcept, met precies één breder concept en notatie D2-nnnn of D3-nnnn."@nl ;
    rdfs:isDefinedBy omg_ont:producten_en_diensten-ap-constraints, omg_voc:producten_en_diensten-ap-constraints ;
    sh:property      [ sh:path skos:topConceptOf ; sh:maxCount 0 ] ,
                     [ sh:path skos:broader ; sh:minCount 1 ] ,
                     [ sh:path skos:notation ; sh:pattern "^D[23]-[0-9]{4}$" ] .

ons:conceptschema
    a                sh:NodeShape ;
    rdfs:label       "conceptschema producten en diensten"@nl ;
    sh:name          "conceptschema producten en diensten"@nl ;
    sh:description   "Het conceptschema van de producten- en dienstencatalogus van het Departement Omgeving."@nl ;
    rdfs:isDefinedBy omg_ont:producten_en_diensten-ap-constraints, omg_voc:producten_en_diensten-ap-constraints ;
    sh:targetClass   skos:ConceptScheme ;
    sh:property      omg_ps:rdf_type, omg_ps:conceptscheme_prefLabel,
                     omg_ps:hasTopConcept, omg_ps:definition .

ons:collectie
    a                sh:NodeShape ;
    rdfs:label       "collectie producten en diensten"@nl ;
    sh:name          "collectie producten en diensten"@nl ;
    sh:description   "Een groepering van diensten volgens type dienst, fase in de beleidscyclus, betrokken afdeling, intern of extern gericht, of interne of externe trigger."@nl ;
    rdfs:isDefinedBy omg_ont:producten_en_diensten-ap-constraints, omg_voc:producten_en_diensten-ap-constraints ;
    sh:targetClass   skos:Collection ;
    sh:property      omg_ps:rdf_type, omg_ps:prefLabel, omg_ps:collection_member,
                     omg_ps:inScheme .

ons:unieke_notatie
    a                sh:NodeShape ;
    rdfs:label       "unieke notatie"@nl ;
    sh:description   "Een notatie identificeert precies één resource."@nl ;
    rdfs:isDefinedBy omg_ont:producten_en_diensten-ap-constraints, omg_voc:producten_en_diensten-ap-constraints ;
    sh:targetObjectsOf skos:notation ;
    sh:property      omg_ps:unique_notation .

# ---------------------------------------------------------------------------
# Property Shapes
# ---------------------------------------------------------------------------

omg_ps:rdf_type
    a                sh:PropertyShape ;
    rdfs:label       "type"@nl ;
    sh:name          "type"@nl ;
    sh:description   "Het RDF-type van de resource."@nl ;
    rdfs:isDefinedBy omg_ont:producten_en_diensten-ap-constraints, omg_voc:producten_en_diensten-ap-constraints ;
    sh:minCount      1 ;
    sh:nodeKind      sh:IRI ;
    sh:path          rdf:type .

omg_ps:prefLabel
    a                sh:PropertyShape ;
    rdfs:label       "voorkeurslabel"@nl ;
    sh:name          "voorkeurslabel"@nl ;
    sh:description   "De benaming van de dienst of collectie in het Nederlands. Precies 1 voorkeurslabel is toegelaten."@nl ;
    rdfs:isDefinedBy omg_ont:producten_en_diensten-ap-constraints, omg_voc:producten_en_diensten-ap-constraints ;
    sh:datatype      rdf:langString ;
    sh:languageIn    ( "nl" ) ;
    sh:minCount      1 ;
    sh:maxCount      1 ;
    sh:nodeKind      sh:Literal ;
    sh:path          skos:prefLabel .

omg_ps:conceptscheme_prefLabel
    a                sh:PropertyShape ;
    rdfs:label       "voorkeurslabel conceptschema"@nl ;
    sh:name          "voorkeurslabel conceptschema"@nl ;
    sh:description   "De benaming van het conceptschema; maximaal 1 per taal (nl, en)."@nl ;
    rdfs:isDefinedBy omg_ont:producten_en_diensten-ap-constraints, omg_voc:producten_en_diensten-ap-constraints ;
    sh:datatype      rdf:langString ;
    sh:languageIn    ( "nl" "en" ) ;
    sh:uniqueLang    true ;
    sh:minCount      1 ;
    sh:maxCount      2 ;
    sh:nodeKind      sh:Literal ;
    sh:path          skos:prefLabel .

omg_ps:altLabel
    a                sh:PropertyShape ;
    rdfs:label       "alternatief label"@nl ;
    sh:name          "alternatief label"@nl ;
    sh:description   "Een alternatieve benaming van de dienst."@nl ;
    rdfs:isDefinedBy omg_ont:producten_en_diensten-ap-constraints, omg_voc:producten_en_diensten-ap-constraints ;
    sh:datatype      rdf:langString ;
    sh:languageIn    ( "nl" "en" ) ;
    sh:nodeKind      sh:Literal ;
    sh:path          skos:altLabel .

omg_ps:notation
    a                sh:PropertyShape ;
    rdfs:label       "notatie"@nl ;
    sh:name          "notatie"@nl ;
    sh:description   "De sleutel van de dienst in de producten- en dienstencatalogus: D1-nnnn, D2-nnnn of D3-nnnn."@nl ;
    rdfs:isDefinedBy omg_ont:producten_en_diensten-ap-constraints, omg_voc:producten_en_diensten-ap-constraints ;
    sh:datatype      xsd:string ;
    sh:pattern       "^D[123]-[0-9]{4}$" ;
    sh:minCount      1 ;
    sh:maxCount      1 ;
    sh:nodeKind      sh:Literal ;
    sh:path          skos:notation .

omg_ps:unique_notation
    a                sh:PropertyShape ;
    rdfs:label       "unieke notatie"@nl ;
    sh:description   "Elke notatie hoort bij precies één resource."@nl ;
    rdfs:isDefinedBy omg_ont:producten_en_diensten-ap-constraints, omg_voc:producten_en_diensten-ap-constraints ;
    sh:nodeKind      sh:IRI ;
    sh:minCount      1 ;
    sh:maxCount      1 ;
    sh:path          [ sh:inversePath skos:notation ] .

omg_ps:inScheme
    a                sh:PropertyShape ;
    rdfs:label       "is in schema"@nl ;
    sh:name          "is in schema"@nl ;
    sh:description   "Het conceptschema waartoe de dienst of collectie behoort."@nl ;
    rdfs:isDefinedBy omg_ont:producten_en_diensten-ap-constraints, omg_voc:producten_en_diensten-ap-constraints ;
    sh:class         skos:ConceptScheme ;
    sh:minCount      1 ;
    sh:maxCount      1 ;
    sh:nodeKind      sh:IRI ;
    sh:path          skos:inScheme .

omg_ps:inScheme_producten_en_diensten
    a                sh:PropertyShape ;
    rdfs:label       "is in schema producten en diensten"@nl ;
    sh:name          "is in schema producten en diensten"@nl ;
    sh:description   "Een dienst behoort tot het conceptschema producten en diensten."@nl ;
    rdfs:isDefinedBy omg_ont:producten_en_diensten-ap-constraints, omg_voc:producten_en_diensten-ap-constraints ;
    sh:hasValue      conceptscheme:producten_en_diensten ;
    sh:path          skos:inScheme .

omg_ps:topConceptOf
    a                sh:PropertyShape ;
    rdfs:label       "topconcept van"@nl ;
    sh:name          "topconcept van"@nl ;
    sh:description   "Het conceptschema waarvan de dienst (niveau 1) een topconcept is."@nl ;
    rdfs:isDefinedBy omg_ont:producten_en_diensten-ap-constraints, omg_voc:producten_en_diensten-ap-constraints ;
    sh:class         skos:ConceptScheme ;
    sh:maxCount      1 ;
    sh:nodeKind      sh:IRI ;
    sh:path          skos:topConceptOf .

omg_ps:broader
    a                sh:PropertyShape ;
    rdfs:label       "breder concept"@nl ;
    sh:name          "breder concept"@nl ;
    sh:description   "De bovenliggende dienst: een dienst van niveau 2 valt onder een dienst van niveau 1, een dienst van niveau 3 onder een dienst van niveau 2."@nl ;
    rdfs:isDefinedBy omg_ont:producten_en_diensten-ap-constraints, omg_voc:producten_en_diensten-ap-constraints ;
    sh:class         skos:Concept ;
    sh:maxCount      1 ;
    sh:nodeKind      sh:IRI ;
    sh:path          skos:broader .

omg_ps:hasTopConcept
    a                sh:PropertyShape ;
    rdfs:label       "heeft topconcept"@nl ;
    sh:name          "heeft topconcept"@nl ;
    sh:description   "De diensten van niveau 1 van het conceptschema."@nl ;
    rdfs:isDefinedBy omg_ont:producten_en_diensten-ap-constraints, omg_voc:producten_en_diensten-ap-constraints ;
    sh:class         skos:Concept ;
    sh:minCount      1 ;
    sh:nodeKind      sh:IRI ;
    sh:path          skos:hasTopConcept .

omg_ps:collection_member
    a                sh:PropertyShape ;
    rdfs:label       "lid"@nl ;
    sh:name          "lid"@nl ;
    sh:description   "Een dienst die tot de collectie behoort."@nl ;
    rdfs:isDefinedBy omg_ont:producten_en_diensten-ap-constraints, omg_voc:producten_en_diensten-ap-constraints ;
    sh:class         skos:Concept ;
    sh:minCount      1 ;
    sh:nodeKind      sh:IRI ;
    sh:path          skos:member .

omg_ps:definition
    a                sh:PropertyShape ;
    rdfs:label       "definitie"@nl ;
    sh:name          "definitie"@nl ;
    sh:description   "Een omschrijving van de betekenis; maximaal 1 per taal (nl, en)."@nl ;
    rdfs:isDefinedBy omg_ont:producten_en_diensten-ap-constraints, omg_voc:producten_en_diensten-ap-constraints ;
    sh:datatype      rdf:langString ;
    sh:languageIn    ( "nl" "en" ) ;
    sh:uniqueLang    true ;
    sh:maxCount      2 ;
    sh:nodeKind      sh:Literal ;
    sh:path          skos:definition .

omg_ps:note
    a                sh:PropertyShape ;
    rdfs:label       "notitie"@nl ;
    sh:name          "notitie"@nl ;
    sh:description   "Een notitie bij de dienst; voor diensten van niveau 3 bevat ze het opgeleverde product, in de vorm 'Product: ...'."@nl ;
    rdfs:isDefinedBy omg_ont:producten_en_diensten-ap-constraints, omg_voc:producten_en_diensten-ap-constraints ;
    sh:datatype      rdf:langString ;
    sh:languageIn    ( "nl" "en" ) ;
    sh:nodeKind      sh:Literal ;
    sh:path          skos:note .
