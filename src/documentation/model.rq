# Leidt het datamodel af uit de data: per klasse de eigenschappen en het type
# (datatype van de literal, klasse van de verwezen resource, of rdfs:Resource).
prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

construct {
    ?type ?p ?datatype
}
where {
    ?s a ?type ; ?p ?o .
    filter(?p != rdf:type)
    optional { ?o a ?type2 }
    bind( coalesce(
        if(isLiteral(?o), replace(replace(str(datatype(?o)),
            "^http://www.w3.org/2001/XMLSchema#", "xsd:"),
            "^http://www.w3.org/1999/02/22-rdf-syntax-ns#", "rdf:"), 1/0),
        if(bound(?type2), ?type2, 1/0),
        rdfs:Resource
    ) as ?datatype )
}
